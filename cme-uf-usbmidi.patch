+boolean CUSBMIDIHostDevice::ForwardCMEMessage (unsigned nCable, const u8 *pData,
+					       unsigned nLength)
+{
+	assert (m_pInterface != 0);
+	assert (pData != 0);
+
+	if (nCable > 15 || nLength == 0)
+	{
+		return FALSE;
+	}
+
+	boolean bResult = FALSE;
+
+	if (pData[0] == 0xF0)
+	{
+		unsigned nOffset = 0;
+
+		while (nOffset < nLength)
+		{
+			unsigned nDataBytes = nLength - nOffset;
+			if (nDataBytes > 3)
+			{
+				nDataBytes = 3;
+			}
+
+			u8 Packet[CUSBMIDIDevice::EventPacketSize] = {0, 0, 0, 0};
+
+			if (nOffset + nDataBytes < nLength)
+			{
+				Packet[0] = (u8) ((nCable << 4) | 0x04);
+			}
+			else
+			{
+				Packet[0] = (u8) ((nCable << 4) | (nDataBytes + 4));
+			}
+
+			memcpy (&Packet[1], pData + nOffset, nDataBytes);
+
+			if (m_pInterface->CallPacketHandler (Packet, sizeof Packet))
+			{
+				bResult = TRUE;
+			}
+
+			nOffset += nDataBytes;
+		}
+
+		return bResult;
+	}
+
+	unsigned nCIN;
+	switch (pData[0])
+	{
+	case 0xF1:
+	case 0xF3:
+		nCIN = 0x02;
+		break;
+
+	case 0xF2:
+		nCIN = 0x03;
+		break;
+
+	case 0xF6:
+		nCIN = 0x05;
+		break;
+
+	default:
+		if (pData[0] >= 0xF8)
+		{
+			nCIN = 0x0F;
+		}
+		else
+		{
+			CLogger::Get ()->Write (FromMIDI, LogWarning,
+						"Unsupported CME MIDI status (0x%X)",
+						(unsigned) pData[0]);
+			return FALSE;
+		}
+		break;
+	}
+
+	if (nLength > 3)
+	{
+		return FALSE;
+	}
+
+	u8 Packet[CUSBMIDIDevice::EventPacketSize] = {0, 0, 0, 0};
+	Packet[0] = (u8) ((nCable << 4) | nCIN);
+	memcpy (&Packet[1], pData, nLength);
+
+	return m_pInterface->CallPacketHandler (Packet, sizeof Packet);
+}
+
+boolean CUSBMIDIHostDevice::ProcessCMEInput (u8 *pBuffer, unsigned nLength)
+{
+	assert (pBuffer != 0);
+	assert (m_pInterface != 0);
+
+	boolean bResult = FALSE;
+	unsigned nRemaining = nLength;
+
+	while (nRemaining >= CUSBMIDIDevice::EventPacketSize)
+	{
+		unsigned nSourceLength = CUSBMIDIDevice::EventPacketSize;
+
+		if ((pBuffer[0] & 0x0F) == 0x0F)
+		{
+			unsigned nDataLength = 1;
+
+			if (pBuffer[1] == 0xF0)
+			{
+				unsigned nEOX = 2;
+				while (nEOX < nRemaining && pBuffer[nEOX] != 0xF7)
+				{
+					nEOX++;
+				}
+
+				if (nEOX >= nRemaining)
+				{
+					CLogger::Get ()->Write (FromMIDI, LogWarning,
+								"CME SysEx without EOX");
+					break;
+				}
+
+				nDataLength = nEOX;
+				nSourceLength = nDataLength + 1;
+			}
+			else if (pBuffer[1] == 0xF2)
+			{
+				nDataLength = 3;
+			}
+
+			if (ForwardCMEMessage (pBuffer[0] >> 4, &pBuffer[1], nDataLength))
+			{
+				bResult = TRUE;
+			}
+		}
+		else
+		{
+			if (m_pInterface->CallPacketHandler (pBuffer,
+							     CUSBMIDIDevice::EventPacketSize))
+			{
+				bResult = TRUE;
+			}
+		}
+
+		pBuffer += nSourceLength;
+		nRemaining -= nSourceLength;
+	}
+
+	return bResult;
+}
